<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Auto | Real | Simulated. Auto (the default) probes for a real instrument or Corona (VMS)
         first, in Helios.dll's own InstrumentAccessContainerFactory order (Fusion, then Exploris,
         then VMS), and falls back to the Simulated backend only if none answered; this matches
         what Helios consumers linking Helios.dll in-process (e.g. the old ScanSpy) got
         automatically. Real requires a real instrument/Corona and fails outright if none is
         found, instead of silently falling back. Simulated always uses the synthetic generator
         (no hardware/license needed), e.g. for the 1000Hz pipeline stress test. -->
    <add key="InstrumentFamily" value="Auto" />
    <add key="Port" value="50100" />
    <!-- 1ms = 1000 scans/sec. PrecisionPeriodicClock (see SimulatedInstrumentGateway) spin-waits to hit this. -->
    <add key="SimulatedScanIntervalMs" value="1" />
  </appSettings>
</configuration>
